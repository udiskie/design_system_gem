<%# locals: (title: nil, description: nil, size: "md", id: "dialog") %>
<div data-dialog-root="<%= id %>" data-state="closed">
  <div
    data-slot="dialog-overlay"
    data-state="closed"
    data-dialog-close
    aria-hidden="true"
    data-aria-hidden="true"
  ></div>

  <div
    data-slot="dialog-content"
    data-state="closed"
    size="<%= size %>"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
  >
    <button type="button" data-type="dialog-close" data-dialog-close aria-label="Close">
      <i class="bi bi-x-lg"></i>
    </button>

    <% if title || description %>
      <header data-type="dialog-header">
        <% if title %><h2 data-type="dialog-title"><%= title %></h2><% end %>
        <% if description %><p data-type="dialog-description"><%= description %></p><% end %>
      </header>
    <% end %>

    <%= yield %>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  (function () {
    if (window.__dialogSetup) return;
    window.__dialogSetup = true;

    function setState(root, state) {
      root.dataset.state = state;
      root.querySelectorAll("[data-state]").forEach(function (el) { el.dataset.state = state; });
    }

    document.addEventListener("click", function (e) {
      var trigger = e.target.closest("[data-dialog-trigger]");
      if (trigger) {
        var root = document.querySelector('[data-dialog-root="' + trigger.dataset.dialogTrigger + '"]');
        if (root) setState(root, "open");
        return;
      }
      var closer = e.target.closest("[data-dialog-close]");
      if (closer) {
        var parent = closer.closest("[data-dialog-root]");
        if (parent) setState(parent, "closed");
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      document.querySelectorAll('[data-dialog-root][data-state="open"]').forEach(function (r) {
        setState(r, "closed");
      });
    });
  })();
<% end %>
