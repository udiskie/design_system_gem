<%# locals: (name:, value: nil, placeholder: "Pick a date") %>
<%
  display_value = value.present? ? value.to_s : nil
%>
<div data-component="date-picker" data-date="<%= value.to_s %>">
  <button type="button" data-slot="date-picker-trigger" <%= 'data-empty' unless display_value %> aria-label="<%= display_value ? "Change date, #{display_value}" : "Pick a date" %>">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 2v4"></path><path d="M16 2v4"></path>
      <rect width="18" height="18" x="3" y="4" rx="2"></rect>
      <path d="M3 10h18"></path>
    </svg>
    <span data-slot="date-picker-label"><%= display_value || placeholder %></span>
  </button>

  <input type="hidden" name="<%= name %>" value="<%= value %>" data-slot="date-picker-input">

  <div data-slot="date-picker-content" data-state="closed" role="dialog" aria-label="Choose date">
    <div data-slot="date-picker-nav">
      <button type="button" data-slot="date-picker-prev" aria-label="Previous month">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div data-slot="date-picker-heading">
        <select data-slot="date-picker-month-select" aria-label="Month"></select>
        <select data-slot="date-picker-year-select" aria-label="Year"></select>
      </div>
      <button type="button" data-slot="date-picker-next" aria-label="Next month">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
    <div data-slot="date-picker-weekdays"></div>
    <div data-slot="date-picker-days"></div>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  (function () {
    if (window.__datePickerSetup) return;
    window.__datePickerSetup = true;

    var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    var DAYS_SHORT = ['Su','Mo','Tu','We','Th','Fr','Sa'];

    function parseDate(str) {
      if (!str) return null;
      var m = str.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (!m) return null;
      return { y: +m[1], mo: +m[2] - 1, d: +m[3] };
    }

    function formatDate(y, mo, d) {
      return y + '-' + String(mo + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
    }

    function getViewState(picker) {
      var today = new Date();
      var sel = parseDate(picker.dataset.date);
      var yr = picker.dataset.viewYear != null ? +picker.dataset.viewYear : (sel ? sel.y : today.getFullYear());
      var mo = picker.dataset.viewMonth != null ? +picker.dataset.viewMonth : (sel ? sel.mo : today.getMonth());
      return { year: yr, month: mo };
    }

    function renderCalendar(picker) {
      var vs = getViewState(picker);
      var year = vs.year, month = vs.month;
      var sel = parseDate(picker.dataset.date);
      var today = new Date();

      var monthSel = picker.querySelector('[data-slot="date-picker-month-select"]');
      if (!monthSel.options.length) {
        MONTHS.forEach(function (name, i) {
          var opt = document.createElement('option');
          opt.value = i; opt.textContent = name;
          monthSel.appendChild(opt);
        });
      }
      monthSel.value = month;

      var yearSel = picker.querySelector('[data-slot="date-picker-year-select"]');
      if (!yearSel.options.length) {
        var base = today.getFullYear();
        for (var y = base - 10; y <= base + 10; y++) {
          var opt = document.createElement('option');
          opt.value = y; opt.textContent = y;
          yearSel.appendChild(opt);
        }
      }
      yearSel.value = year;

      var weekdaysEl = picker.querySelector('[data-slot="date-picker-weekdays"]');
      if (!weekdaysEl.children.length) {
        DAYS_SHORT.forEach(function (d) {
          var span = document.createElement('span');
          span.textContent = d;
          weekdaysEl.appendChild(span);
        });
      }

      var daysEl = picker.querySelector('[data-slot="date-picker-days"]');
      daysEl.innerHTML = '';

      var firstDay = new Date(year, month, 1).getDay();
      var daysInMonth = new Date(year, month + 1, 0).getDate();

      for (var i = 0; i < firstDay; i++) {
        daysEl.appendChild(document.createElement('span'));
      }
      for (var d = 1; d <= daysInMonth; d++) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = d;
        btn.dataset.day = d;
        if (sel && sel.y === year && sel.mo === month && sel.d === d) btn.dataset.selected = '';
        if (today.getFullYear() === year && today.getMonth() === month && today.getDate() === d) btn.dataset.today = '';
        daysEl.appendChild(btn);
      }
    }

    function openPicker(picker) {
      document.querySelectorAll('[data-component="date-picker"][data-state="open"]').forEach(function (p) {
        closePicker(p);
      });
      picker.dataset.state = 'open';
      picker.querySelector('[data-slot="date-picker-content"]').dataset.state = 'open';
      renderCalendar(picker);
    }

    function closePicker(picker) {
      picker.dataset.state = 'closed';
      picker.querySelector('[data-slot="date-picker-content"]').dataset.state = 'closed';
    }

    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-slot="date-picker-trigger"]');
      if (trigger) {
        var picker = trigger.closest('[data-component="date-picker"]');
        if (picker.dataset.state === 'open') closePicker(picker);
        else openPicker(picker);
        return;
      }

      var prev = e.target.closest('[data-slot="date-picker-prev"]');
      if (prev) {
        var picker = prev.closest('[data-component="date-picker"]');
        var vs = getViewState(picker);
        var mo = vs.month - 1, yr = vs.year;
        if (mo < 0) { mo = 11; yr--; }
        picker.dataset.viewMonth = mo;
        picker.dataset.viewYear = yr;
        renderCalendar(picker);
        return;
      }

      var next = e.target.closest('[data-slot="date-picker-next"]');
      if (next) {
        var picker = next.closest('[data-component="date-picker"]');
        var vs = getViewState(picker);
        var mo = vs.month + 1, yr = vs.year;
        if (mo > 11) { mo = 0; yr++; }
        picker.dataset.viewMonth = mo;
        picker.dataset.viewYear = yr;
        renderCalendar(picker);
        return;
      }

      var dayBtn = e.target.closest('[data-slot="date-picker-days"] > button');
      if (dayBtn) {
        var picker = dayBtn.closest('[data-component="date-picker"]');
        var vs = getViewState(picker);
        var formatted = formatDate(vs.year, vs.month, +dayBtn.dataset.day);
        picker.dataset.date = formatted;
        picker.querySelector('[data-slot="date-picker-input"]').value = formatted;
        picker.querySelector('[data-slot="date-picker-label"]').textContent = formatted;
        delete picker.querySelector('[data-slot="date-picker-trigger"]').dataset.empty;
        closePicker(picker);
        return;
      }

      if (!e.target.closest('[data-component="date-picker"]')) {
        document.querySelectorAll('[data-component="date-picker"][data-state="open"]').forEach(closePicker);
      }
    });

    document.addEventListener('change', function (e) {
      var monthSel = e.target.closest('[data-slot="date-picker-month-select"]');
      if (monthSel) {
        var picker = monthSel.closest('[data-component="date-picker"]');
        picker.dataset.viewMonth = +monthSel.value;
        renderCalendar(picker);
        return;
      }
      var yearSel = e.target.closest('[data-slot="date-picker-year-select"]');
      if (yearSel) {
        var picker = yearSel.closest('[data-component="date-picker"]');
        picker.dataset.viewYear = +yearSel.value;
        renderCalendar(picker);
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-component="date-picker"][data-state="open"]').forEach(closePicker);
      }
    });
  })();
<% end %>
